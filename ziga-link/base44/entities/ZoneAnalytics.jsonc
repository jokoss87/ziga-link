{
  "type": "object",
  "name": "ZoneAnalytics",
  "properties": {
    "zoneTag": {
      "type": "string",
      "title": "Zone (eymoutiers, limoges, paris, etc.)"
    },
    "totalDogs": {
      "type": "integer",
      "title": "Nombre total de chiens",
      "default": 0
    },
    "activeDogs": {
      "type": "integer",
      "title": "Chiens actifs",
      "default": 0
    },
    "totalMatchesCreated": {
      "type": "integer",
      "title": "Matchs cr\u00e9\u00e9s",
      "default": 0
    },
    "matchAcceptanceRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Taux d'acceptation des matchs (%)",
      "default": 0
    },
    "meetupConversionRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "title": "Taux de conversion en rencontres (%)",
      "default": 0
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "title": "Derni\u00e8re mise \u00e0 jour"
    }
  },
  "required": [
    "zoneTag"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}